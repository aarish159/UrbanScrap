# Urban Scrap Supabase Frontend Configuration
# Replace these placeholder values with your actual project credentials from the Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon / public key)

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# IMPORTANT SECURITY NOTE:
# NEVER put your SUPABASE_SERVICE_ROLE_KEY in this file or any frontend code!
# The service_role key bypasses Row Level Security and must only be used in secure server environments.
