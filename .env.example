# Urban Scrap Supabase Frontend Configuration
# Replace these placeholder values with your actual project credentials from the Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon / public key)

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Optional: Application base URL (Defaults automatically to current window.location.origin)
# Production: https://urbanscrap.onrender.com
# Local: http://localhost:3000
VITE_APP_URL=http://localhost:3000

# ====================================================================
# SUPABASE AUTHENTICATION URL CONFIGURATION GUIDE
# ====================================================================
# In your Supabase Dashboard -> Authentication -> URL Configuration:
#
# 1. Site URL:
#    https://urbanscrap.onrender.com
#    (or http://localhost:3000 during local development)
#
# 2. Redirect URLs (Add each of these exact URLs to the Redirect URLs allowlist):
#    - https://urbanscrap.onrender.com/reset-password
#    - https://urbanscrap.onrender.com/auth/callback
#    - https://urbanscrap.onrender.com/**
#    - http://localhost:3000/reset-password
#    - http://localhost:3000/auth/callback
#    - http://localhost:3000/**
#    - http://localhost:5173/reset-password
#    - http://localhost:5173/auth/callback
#
# ====================================================================
# IMPORTANT SECURITY NOTE:
# NEVER put your SUPABASE_SERVICE_ROLE_KEY in this file or any frontend code!
# The service_role key bypasses Row Level Security and must only be used in secure server environments.
# ====================================================================
